# =============================================
# Regime-Trader 云服务器定时任务（crontab）
# =============================================
# 部署位置：Linux 云服务器（Ubuntu），时区必须为 Asia/Shanghai
# 校验时区：timedatectl status | grep "Time zone"
#           若非 Asia/Shanghai，执行：
#             sudo timedatectl set-timezone Asia/Shanghai
#
# 前置依赖（一次性）：
#   cd /srv/regime-trader
#   python3 -m venv .venv
#   ./.venv/bin/pip install -r requirements.txt
#   ./.venv/bin/pip install ./wheels/AmazingData-1.1.9-cp314-none-any.whl ./wheels/tgw-1.0.9.2-py3-none-any.whl
#   配置 .env（拷贝本地 .env，含 MX_APIKEY/TGW_* 等）
#
# 使用方法：
#   crontab deploy/crontab.server     # 安装
#   crontab -l                        # 查看
#   crontab -r                        # 移除
#
# 注意：
#   - 所有命令都在项目根目录执行
#   - 日志由脚本自行写入 logs/<prefix>.log（含 _debug.log），cron 不重复重定向；
#     stdout 丢弃，仅 stderr（启动失败/未捕获异常）追加到 logs/cron_error.log
#   - flock 防止任务重入（节假日/周末趋势任务重叠等）
#   - 趋势任务分两次：trend_sell 14:45 尾盘（卖出执行）、trend_analysis 15:10 盘后（买入分析）。
#     两者用不同 flock 锁，互不阻塞；脚本内部无交易日判断，
#     cron 用 1-5 限定，法定节假日会多跑一次（产出空报告/无持仓退出，无碍）
# =============================================

# ── 趋势卖出执行：每交易日 14:45 尾盘（检测卖出信号→自动下模拟仓市价单→出成交报告并推送）──
#    须在 15:00 收盘前运行，收盘后模拟仓不可交易
45 14 * * 1-5 cd /root/regime-trader && flock -n /tmp/trend-sell.lock /root/miniconda/envs/rt/bin/python trend_sell.py > /dev/null 2>> logs/cron_error.log

# ── 趋势跟踪分析：每交易日 15:10 收盘后（买入信号 + 剔除/负面清单，推送结果）──
10 15 * * 1-5 cd /root/regime-trader && flock -n /tmp/trend.lock /root/miniconda/envs/rt/bin/python trend_analysis.py > /dev/null 2>> logs/cron_error.log

# ── ETF 周度观察 + 自动调仓：每周一 10:10（开盘后，妙想市价单可成交）──
10 10 * * 1 cd /root/regime-trader && flock -n /tmp/etf.lock /root/miniconda/envs/rt/bin/python etf_observe.py --execute > /dev/null 2>> logs/cron_error.log

# ── 风格状态周报：每周日 9:00（产出 data/style_state.json 供周一 etf 批次引用）──
0 9 * * 7 cd /root/regime-trader && flock -n /tmp/style.lock /root/miniconda/envs/rt/bin/python style_report.py > /dev/null 2>> logs/cron_error.log
